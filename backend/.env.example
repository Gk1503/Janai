PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/janai?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Self-hosted SMS gateway (Dashboard -> API keys). Keep the key on the backend only.
SMS_GATEWAY_URL=http://localhost:4000
SMS_GATEWAY_KEY=sg_your_gateway_api_key
# OTP SMS wording, {code} is replaced with the code. Optional.
# SMS_OTP_TEMPLATE=Janai: {code} is your verification code.
